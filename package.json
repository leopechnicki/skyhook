{
  "name": "skyhook",
  "version": "1.0.0",
  "description": "SKYHOOK - a one-touch neon climbing arcade game. Hook, swing, release. Zero dependencies, zero build step, runs from file://.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve .",
    "test": "node test/smoke.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:headed": "node test/smoke.mjs --headed",
    "test:balance": "node test/balance.mjs",
    "test:world": "node test/world.mjs",
    "test:perf": "node test/perf.mjs",
    "test:art": "node test/art_shots.mjs",
    "test:rocket": "node test/rocket_shots.mjs",
    "shots": "node test/shipping_shots.mjs",
    "test:ci": "node test/world.mjs && node test/balance.mjs --ci && node test/smoke.mjs && node test/perf.mjs"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  },
  "keywords": ["game", "arcade", "canvas", "html5", "one-touch", "no-build", "vanilla-js"],
  "repository": { "type": "git", "url": "https://github.com/leopechnicki/skyhook.git" },
  "homepage": "https://leopechnicki.github.io/skyhook/"
}
