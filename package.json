{
  "name": "skyhook",
  "version": "1.0.0",
  "description": "SKYHOOK - a one-touch neon climbing arcade game. Hook, swing, release. Zero dependencies, zero build step, runs from file://.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve .",
    "test": "node test/smoke.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:headed": "node test/smoke.mjs --headed",
    "test:balance": "node test/balance.mjs",
    "test:world": "node test/world.mjs",
    "test:latency": "node test/latency.mjs",
    "test:sprites": "node test/sprites.mjs",
    "test:ship": "node test/ship.mjs",
    "test:ship-ui": "node test/ship_ui.mjs",
    "test:ship-live": "node test/ship_live.mjs",
    "test:perf": "node test/perf.mjs",
    "test:art": "node test/art_shots.mjs",
    "test:online": "node test/online.mjs",
    "test:pages": "node test/pages_stub.mjs",
    "test:staging": "node test/staging.mjs",
    "test:leaderboard": "node test/leaderboard_ui.mjs",
    "test:rocket": "node test/rocket_shots.mjs",
    "shots": "node test/shipping_shots.mjs",
    "test:ci": "node test/world.mjs && node test/balance.mjs --ci && node test/latency.mjs && node test/online.mjs && node test/pages_stub.mjs && node test/ship.mjs && node test/ship_ui.mjs && node test/staging.mjs && node test/smoke.mjs && node test/sprites.mjs && node test/leaderboard_ui.mjs && node test/perf.mjs"
  },
  "devDependencies": {
    "playwright": "^1.55.1"
  },
  "keywords": ["game", "arcade", "canvas", "html5", "one-touch", "no-build", "vanilla-js"],
  "repository": { "type": "git", "url": "https://github.com/leopechnicki/skyhook.git" },
  "homepage": "https://skyhookplay.com/"
}
